# ============================================================
# GUIDES MONOREPO
# Python + FastAPI + Flutter/Dart
# ============================================================


# ============================================================
# PYTHON
# ============================================================

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class

# Python compiled/native files
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python packaging / distribution
.Python
dist/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Build directories
# IMPORTANT:
# This is safe in a monorepo because build/ is generated output.
**/build/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
coverage/
*.cover
*.py.cover

# Type checkers / linters
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/
cython_debug/

# Jupyter
.ipynb_checkpoints/

# PyInstaller
*.manifest
*.spec

# Django
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask
instance/
.webassets-cache/

# Scrapy
.scrapy/

# PDM
.pdm-python
.pdm-build/

# Pixi
.pixi/

# PEP 582
__pypackages__/

# Celery
celerybeat-schedule
celerybeat.pid

# Redis / broker runtime files
*.rdb
*.aof
*.pid

# Jupyter / IPython
profile_default/
ipython_config.py

# Environment / secrets
.env
.env.*
!.env.example

# PyPI
.pypirc


# ============================================================
# PYTHON TOOLING / PACKAGE MANAGERS
# ============================================================

# UV
# Keep uv.lock tracked for applications/projects.
# Do NOT ignore uv.lock globally.

# Poetry
# Keep poetry.lock tracked for applications/projects.
# Do NOT ignore poetry.lock globally.

# Pipenv
# Keep Pipfile.lock tracked for applications/projects.
# Do NOT ignore Pipfile.lock globally.


